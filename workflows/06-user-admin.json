    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 4
          },
          "conditions": [
            {
              "id": "84df0e3f-2791-45a5-8965-0374b969c1a1",
              "leftValue": "={{ $('User form').item.json.action }}",
              "rightValue": "add",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b5ff8570-7ee1-49ae-aa76-5986040013bd",
      "name": "Add?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        360,
        -120
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with u as (insert into app_users (email, display_name, role, active, created_by) values (lower($1), coalesce(nullif($2, ''), split_part($1, '@', 1)), coalesce(nullif($3, ''), 'clerk')::user_role, true, 'n8n form') on conflict (email) do update set display_name = coalesce(nullif($2, ''), app_users.display_name), role = coalesce(nullif($3, ''), app_users.role::text)::user_role, active = true returning email, display_name, role) insert into audit_log (actor, action, note) select 'super admin (form)', 'user_upserted', u.email || ' as ' || u.role from u returning note",
        "options": {
          "queryReplacement": "={{ [ $('User form').item.json.email, $('User form').item.json.name || '', $('User form').item.json.role || '' ] }}"
        }
      },
      "id": "00b0d56c-3ef2-452d-b0a1-9b663f82bbb6",
      "name": "Add / update user",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        600,
        -200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with u as (update app_users set active = false where email = lower($1) returning email) insert into audit_log (actor, action, note) select 'super admin (form)', 'user_removed', u.email from u returning note",
        "options": {
          "queryReplacement": "={{ [ $('User form').item.json.email ] }}"
        }
      },
      "id": "d42339e4-c0a5-4a79-b254-9ec71ad18510",
      "name": "Remove user",
