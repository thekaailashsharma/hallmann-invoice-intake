      "id": "806de4ef-7789-4f6f-afbd-9cdd5b7dc0b4",
      "name": "Refused",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        360,
        160
      ],
      "webhookId": "7d3b0a7e-users-00002"
