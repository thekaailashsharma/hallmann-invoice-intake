{
  "id": "InvUserAdmin00001",
  "name": "User Admin",
  "nodes": [
    {
      "parameters": {
        "content": "## User admin form\nSuper admin adds or removes people without touching the database. The passphrase is checked against a bcrypt hash in app_settings; every change is audited. Sign-in itself is Google via Firebase; this table decides who gets in and with which role.",
        "height": 150,
        "width": 760,
        "color": 5
      },
      "id": "544c1f95-856a-4114-9a13-96baa62e4b21",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -220
      ]
    },
    {
      "parameters": {
        "formTitle": "Hallmann invoice intake · user admin",
        "formDescription": "Add a person (they sign in with Google) or remove access. Super admin passphrase required.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Action",
              "fieldName": "action",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "add"
                  },
                  {
                    "option": "remove"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Email (Google account)",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Name",
              "fieldName": "name",
              "placeholder": "needed for add"
            },
            {
              "fieldLabel": "Role",
              "fieldName": "role",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "clerk"
                  },
                  {
                    "option": "lead"
                  },
                  {
                    "option": "admin"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Super admin passphrase",
              "fieldName": "passphrase",
              "fieldType": "password",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Apply"
        }
      },
      "id": "220154f0-e15a-4308-a4a9-faa401ea149a",
      "name": "User form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        -360,
        0
      ],
      "webhookId": "7d3b0a7e-users-00001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select (crypt($1, value) = value) as ok from app_settings where key = 'super_admin_key'",
        "options": {
          "queryReplacement": "={{ [ String($json.passphrase || '') ] }}"
        }
      },
      "id": "2adef786-5363-486d-a26f-dbb03d8b440d",
      "name": "Check passphrase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -120,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 4
          },
          "conditions": [
            {
              "id": "49ac107f-4ae2-49a2-bedf-e6c4afd53f9b",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "279aa41c-1a51-4aa9-9fed-3da3f4189ba1",
      "name": "Passphrase ok?",
