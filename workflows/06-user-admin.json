{
  "id": "InvUserAdmin00001",
  "name": "User Admin",
  "nodes": [
    {
      "parameters": {
        "content": "## User admin form\nSuper admin adds or removes people without touching the database. The form is protected by n8n Basic Auth (credential \"Super admin (form)\"); every change is audited. Sign-in itself is Google via Firebase; this table decides who gets in and with which role.",
        "height": 150,
        "width": 760,
        "color": 5
      },
      "id": "e0a0ab5c-267c-42bd-8a9b-dd78ee9f9342",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -220
      ]
    },
    {
      "parameters": {
        "formTitle": "Hallmann invoice intake · user admin",
        "formDescription": "Add a person (they sign in with Google) or remove access.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Action",
              "fieldName": "action",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "add"
                  },
                  {
                    "option": "remove"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Email (Google account)",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Name",
              "fieldName": "name",
              "placeholder": "needed for add"
            },
            {
              "fieldLabel": "Role",
              "fieldName": "role",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "clerk"
                  },
                  {
                    "option": "lead"
                  },
                  {
                    "option": "admin"
                  }
                ]
              }
            }
          ]
        },
        "authentication": "basicAuth",
        "options": {
          "buttonLabel": "Apply"
        }
      },
      "id": "852e7f8e-dc6d-4be4-9530-c9aec9f1eea7",
      "name": "User form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        -360,
        0
      ],
      "webhookId": "7d3b0a7e-users-00001"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 4
          },
          "conditions": [
            {
              "id": "d0fcbdb8-d288-4cce-aa0e-6ece5b4c292c",
              "leftValue": "={{ $('User form').item.json.action }}",
              "rightValue": "add",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e7d87226-c4bd-47bb-8752-eecb13298cd0",
      "name": "Add?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with u as (insert into app_users (email, display_name, role, active, created_by) values (lower($1), coalesce(nullif($2, ''), split_part($1, '@', 1)), coalesce(nullif($3, ''), 'clerk')::user_role, true, 'n8n form') on conflict (email) do update set display_name = coalesce(nullif($2, ''), app_users.display_name), role = coalesce(nullif($3, ''), app_users.role::text)::user_role, active = true returning email, display_name, role) insert into audit_log (actor, action, note) select 'super admin (form)', 'user_upserted', u.email || ' as ' || u.role from u returning note",
        "options": {
          "queryReplacement": "={{ [ $('User form').item.json.email, $('User form').item.json.name || '', $('User form').item.json.role || '' ] }}"
        }
      },
      "id": "cc7fe83b-43d4-4864-93e5-dc319abd9647",
      "name": "Add / update user",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        600,
        -200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with u as (update app_users set active = false where email = lower($1) returning email) insert into audit_log (actor, action, note) select 'super admin (form)', 'user_removed', u.email from u returning note",
        "options": {
          "queryReplacement": "={{ [ $('User form').item.json.email ] }}"
        }
      },
      "id": "4cf2a044-5556-4c88-b7ff-8ead36020def",
      "name": "Remove user",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        600,
        -40
      ]
    },
    {
