{
  "id": "InvErpRetry000001",
  "name": "ERP Retry",
  "nodes": [
    {
      "parameters": {
        "content": "## ERP Retry\nEvery 5 minutes: if the ERP is back, book everything that is waiting. When the backlog is cleared the open ERP alert is acknowledged automatically.",
        "height": 130,
        "width": 620,
        "color": 4
      },
      "id": "ac34f350-991b-4c04-8b74-0b668f4c534b",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "1ee5e5e4-767f-4d20-a665-a99a08772e8e",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -360,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "7b8582b2-cb98-40a2-bad7-a0674447ed54",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -360,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select d.id as document_id from documents d cross join erp_status s where d.status = 'pending_erp' and s.available order by d.created_at limit 50",
        "options": {}
      },
      "id": "f75869ed-093b-4d72-ac86-97d686c7a5e2",
      "name": "Pending bookings (ERP up)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "InvErpBooking0001"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "document_id": "={{ $json.document_id }}",
            "actor": "system"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "document_id",
              "displayName": "document_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "actor",
              "displayName": "actor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "e198dc77-9413-4508-97f6-8bd49266ea30",
      "name": "Book in ERP",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update alerts set acknowledged = true where source = 'erp-booking' and severity = 'warning' and acknowledged = false and not exists (select 1 from documents where status = 'pending_erp') returning id",
        "options": {}
      },
      "id": "8301a80d-75fe-417a-9cc8-51cbbc239628",
      "name": "Resolve ERP alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        360,
        0
      ],
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending bookings (ERP up)": {
      "main": [
        [
          {
            "node": "Book in ERP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Book in ERP": {
      "main": [
        [
          {
            "node": "Resolve ERP alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "errorWorkflow": "InvErrorHandler01"
  },
