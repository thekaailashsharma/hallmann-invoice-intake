{
  "id": "InvErpRetry000001",
  "name": "ERP Retry",
  "nodes": [
    {
      "parameters": {
        "content": "## ERP Retry\nEvery 5 minutes: if the ERP is back, book everything that is waiting. When the backlog is cleared the open ERP alert is acknowledged automatically.",
        "height": 130,
        "width": 620,
        "color": 4
      },
      "id": "dac2587d-6413-4db3-800d-8a2a5243e0e6",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "f5702022-110f-4bbb-a115-5f51e5f45dc0",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -360,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "c0776217-4b1a-4505-b1f0-323facb879f8",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -360,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select d.id as document_id from documents d cross join erp_status s where d.status = 'pending_erp' and s.available order by d.created_at limit 50",
        "options": {}
      },
      "id": "c9726d65-45c5-4cf8-8de1-79bdfd93eb2d",
      "name": "Pending bookings (ERP up)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "InvErpBooking0001"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "document_id": "={{ $json.document_id }}",
            "actor": "system"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "document_id",
              "displayName": "document_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "actor",
              "displayName": "actor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "4cad41e5-99d6-4217-966e-9b1380b8a790",
      "name": "Book in ERP",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update alerts set acknowledged = true where source = 'erp-booking' and severity = 'warning' and acknowledged = false and not exists (select 1 from documents where status = 'pending_erp') returning id",
        "options": {}
      },
      "id": "1a2aa60d-90ce-4380-bfd5-6363306c60dd",
      "name": "Resolve ERP alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        360,
        0
      ],
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending bookings (ERP up)": {
      "main": [
        [
          {
            "node": "Book in ERP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Book in ERP": {
      "main": [
        [
          {
            "node": "Resolve ERP alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
