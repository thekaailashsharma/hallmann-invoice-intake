{
  "id": "InvErpRetry000001",
  "name": "ERP Retry",
  "nodes": [
    {
      "parameters": {
        "content": "## ERP Retry\nEvery 5 minutes: if the ERP is back, book everything that is waiting. When the backlog is cleared the open ERP alert is acknowledged automatically.",
        "height": 130,
        "width": 620,
        "color": 4
      },
      "id": "d24574bf-1e40-4e1d-b52e-4426e68d6aec",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "7a4ac7d4-53f3-4874-b29f-1cd35eca2dc4",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -360,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "4eaa5290-a8c5-4513-ac07-b8732ef4c0fb",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -360,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select d.id as document_id from documents d cross join erp_status s where d.status = 'pending_erp' and s.available order by d.created_at limit 50",
        "options": {}
      },
      "id": "454dc1e9-b4bd-4525-9370-61809775b4e6",
      "name": "Pending bookings (ERP up)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "InvErpBooking0001"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "document_id": "={{ $json.document_id }}",
            "actor": "system"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "document_id",
              "displayName": "document_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "actor",
              "displayName": "actor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "cf377df3-b0b2-4043-baa3-f5974bc2e1eb",
      "name": "Book in ERP",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update alerts set acknowledged = true where source = 'erp-booking' and severity = 'warning' and acknowledged = false and not exists (select 1 from documents where status = 'pending_erp') returning id",
        "options": {}
      },
      "id": "466a0679-e498-447f-9e81-e10e12d798cc",
      "name": "Resolve ERP alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        360,
        0
      ],
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
