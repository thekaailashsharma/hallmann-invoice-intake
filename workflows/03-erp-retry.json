{
  "id": "InvErpRetry000001",
  "name": "ERP Retry",
  "nodes": [
    {
      "parameters": {
        "content": "## ERP Retry\nEvery 5 minutes: if the ERP is back, book everything that is waiting. When the backlog is cleared the open ERP alert is acknowledged automatically.",
        "height": 130,
        "width": 620,
        "color": 4
      },
      "id": "a2b76ed0-7c15-446d-84d0-a4f254312f03",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "d3e06c9d-c687-482e-bb53-97b673a3a9e1",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -360,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "0ae68170-ba43-4798-8c07-3919d77d9478",
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -360,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select d.id as document_id from documents d cross join erp_status s where d.status = 'pending_erp' and s.available order by d.created_at limit 50",
        "options": {}
      },
      "id": "da021f50-9dd1-45f7-a83b-a2a485f10f5c",
      "name": "Pending bookings (ERP up)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "InvErpBooking0001"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "document_id": "={{ $json.document_id }}",
            "actor": "system"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "document_id",
              "displayName": "document_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "actor",
              "displayName": "actor",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ]
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "579b10a5-df9f-4552-8ad4-2616137aac56",
      "name": "Book in ERP",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update alerts set acknowledged = true where source = 'erp-booking' and severity = 'warning' and acknowledged = false and not exists (select 1 from documents where status = 'pending_erp') returning id",
        "options": {}
      },
      "id": "4f7e14be-7dbd-4a1e-985a-4dcdccfe9cc5",
      "name": "Resolve ERP alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        360,
        0
      ],
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Pending bookings (ERP up)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending bookings (ERP up)": {
      "main": [
        [
          {
            "node": "Book in ERP",
            "type": "main",
            "index": 0
          }
        ]
      ]
