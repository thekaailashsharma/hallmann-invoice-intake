    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4000/api/v1/supplier-invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ external_ref: $json.id, supplier_vat_id: $json.supplier_vat_id, supplier_name: $json.supplier_name, invoice_number: $json.invoice_number, doc_type: $json.doc_type, invoice_date: $json.invoice_date, due_date: $json.due_date, currency: $json.currency, net_amount: Number($json.net_amount), vat_amount: Number($json.vat_amount), gross_amount: Number($json.gross_amount), po_number: $json.po_number, booked_by: $json.actor }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ef4173a3-bae2-42d8-9c8a-75c937481cb1",
      "name": "Send to ERP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        116,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Map the ERP's HTTP answer to one outcome. Network errors (no answer after 3 quick tries) arrive on the error output as 'down'.\nconst doc = $('Claim document').item.json; const code = Number($json.statusCode || 0); const body = $json.body || {};\n// Booked only with the ERP's own booking id: some systems answer maintenance with a '200 OK' web page.\nconst outcome = (code === 200 || code === 201) && body && body.id ? 'booked' : (code === 200 || code === 201) ? 'error' : code === 409 ? 'duplicate' : [400, 404, 422].includes(code) ? 'rejected' : [0, 502, 503, 504].includes(code) || !code ? 'down' : 'error';\nconst msg = outcome === 'booked' ? 'Booked in ERP.' : outcome === 'down' ? `ERP not reachable (${code || ($json.error && $json.error.message) || 'no answer'}). Waiting; retried every 5 minutes.`\n  : `ERP answered ${code}: ${typeof body === 'object' ? (body.error || JSON.stringify(body)) : String(body).slice(0, 200)}${body.fields ? ' (' + body.fields.join(', ') + ')' : ''}`;\nreturn { json: { document_id: doc.id, actor: doc.actor, outcome, erp_id: body.id || null, msg } };",
        "mode": "runOnceForEachItem"
      },
      "id": "5cbf89a4-f20d-488b-ab91-c1901711ec7b",
      "name": "Read ERP answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        435,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b48fa678-9663-49f5-adfd-3f34d1fe31ee",
              "name": "statusCode",
              "value": 0,
              "type": "number"
            },
            {
              "id": "5ee9e99e-14d4-4600-a03a-6108ac93515a",
              "name": "body",
              "value": "={{ { error: ($json.error && $json.error.message) || 'no answer (timeout or connection refused)' } }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "07188292-85bb-4b85-99ae-a0557e491264",
      "name": "No answer from ERP",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        276,
        256
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with r as (select $1::uuid as id, $2::text as outcome, $3::text as erp_id, $4::text as msg, $5::text as actor), u as (update documents d set status = (case r.outcome when 'booked' then 'booked' when 'duplicate' then 'duplicate' when 'rejected' then 'needs_review' when 'error' then case when d.erp_attempts + 1 >= 3 then 'needs_review' else 'pending_erp' end else 'pending_erp' end)::doc_status, erp_invoice_id = case when r.outcome = 'booked' then r.erp_id::uuid else d.erp_invoice_id end, erp_attempts = d.erp_attempts + case when r.outcome = 'error' then 1 else 0 end, last_error = case when r.outcome = 'booked' then null else r.msg end, booking_started_at = null, updated_at = now(), reasons = case when r.outcome = 'duplicate' then d.reasons || '[\"ERP already has this supplier + invoice number.\"]'::jsonb when r.outcome = 'rejected' then d.reasons || jsonb_build_array('ERP refused the booking: ' || r.msg) when r.outcome = 'error' and d.erp_attempts + 1 >= 3 then d.reasons || jsonb_build_array('ERP booking failed 3 times: ' || r.msg || '. Check the values, then approve again.') else d.reasons end from r where d.id = r.id returning d.id, d.status), a as (insert into audit_log (actor, action, document_id, after, note) select r.actor, case r.outcome when 'booked' then 'erp_booked' when 'duplicate' then 'erp_rejected_duplicate' when 'rejected' then 'erp_rejected' when 'down' then 'erp_unavailable' else 'erp_error' end, r.id, jsonb_build_object('status', (select status from u), 'erp_invoice_id', r.erp_id), r.msg from r where r.outcome <> 'down' or not exists (select 1 from audit_log where document_id = r.id and action = 'erp_unavailable' and ts > now() - interval '1 hour') returning 1), s as (update erp_status set available = (r.outcome <> 'down'), note = case when r.outcome = 'down' then 'ERP not reachable at last booking attempt' else 'ERP answering' end, updated_at = now() from r where erp_status.id = 1 returning 1) select u.id as document_id, u.status::text as status, r.outcome, r.msg, (u.status = 'needs_review' and r.outcome in ('error', 'rejected')) as handed_back from u, r",
        "options": {
          "queryReplacement": "={{ [ $json.document_id, $json.outcome, $json.erp_id, $json.msg, $json.actor ] }}"
        }
      },
      "id": "ca144b7d-db63-488e-a46a-cf9be9de2fd5",
      "name": "Record result",
