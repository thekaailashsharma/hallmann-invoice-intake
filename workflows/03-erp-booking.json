              "neverError": true
            }
          }
        }
      },
      "id": "f44303c7-995e-4cec-9151-5f52d930a039",
      "name": "Send to ERP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        116,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueErrorOutput"
