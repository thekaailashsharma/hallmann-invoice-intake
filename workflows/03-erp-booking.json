    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update documents set booking_started_at = now() where id = $1::uuid and status = 'pending_erp' and (booking_started_at is null or booking_started_at < now() - interval '2 minutes') returning id, supplier_vat_id, supplier_name, invoice_number, doc_type::text as doc_type, invoice_date::text as invoice_date, due_date::text as due_date, currency, net_amount, vat_amount, gross_amount, po_number, $2::text as actor",
        "options": {
          "queryReplacement": "={{ [ $json.document_id, $json.actor || 'system' ] }}"
        }
      },
      "id": "38bb3912-ebd4-41df-8912-20d323692842",
      "name": "Claim document",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -203,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
