    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with ex as (update alerts set occurrences = occurrences + 1, last_seen = now() where id = (select id from alerts where source = 'erp-booking' and message = $2 and not acknowledged and ts > now() - interval '24 hours' order by ts desc limit 1) returning id), ins as (insert into alerts (severity, source, message, details) select $1, 'erp-booking', $2, jsonb_build_object('document_id', $3, 'detail', $4)::jsonb where not exists (select 1 from ex) returning id) select (select id from ins) is not null as is_new, $1 as severity, 'erp-booking' as source, $2 as message",
        "options": {
          "queryReplacement": "={{ [ $json.outcome === 'down' ? 'warning' : 'critical', $json.outcome === 'down' ? 'ERP not reachable; bookings wait and are retried every 5 minutes' : 'ERP booking returned to review: ' + ($json.outcome === 'rejected' ? 'ERP refused it' : 'failed 3 times'), $json.document_id, $json.msg ] }}"
        }
