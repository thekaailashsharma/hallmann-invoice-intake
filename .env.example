# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=                      # any OpenAI-compatible key; set LLM_BASE_URL for another provider
# LLM_BASE_URL=https://api.sarvam.ai/v1
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-long-random
N8N_WEBHOOK_KEY=change-me-long-random       # shared secret between the review app and n8n
ERP_API_KEY=change-me-long-random           # mock ERP key (production: the real ERP credential)

# Mailbox (bundled test mailbox by default)
MAILBOX_USER=rechnungen@hallmann.example
MAILBOX_PASSWORD=mailbox
IMAP_ENABLED=true
GMAIL_ENABLED=false                          # true after creating a "Gmail OAuth2" credential in n8n
GMAIL_QUERY=in:inbox -label:Processed
ALERT_EMAIL_TO=oncall@avanai.example

# Optional: use an existing n8n instead of the bundled one
# N8N_CONTAINER=sarvam-n8n
# N8N_URL=http://localhost:5678
# PG_HOST_FOR_N8N=host.docker.internal
# PG_PORT_FOR_N8N=5433
# MAILBOX_HOST_FOR_N8N=host.docker.internal
# ERP_BASE_URL_FOR_N8N=http://host.docker.internal:4000
# N8N_WEBHOOK_BASE=http://host.docker.internal:5678/webhook

# Firebase Auth (web config is public; the admin credential lives in ./secrets, never in Git)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
DEMO_MODE=false
CLERK_APPROVAL_LIMIT=10000

# Access control
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
