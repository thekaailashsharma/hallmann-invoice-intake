# Copy to .env
SARVAM_API_KEY=sk_...            # any OpenAI-compatible provider works; see README
POSTGRES_PASSWORD=intake
N8N_ENCRYPTION_KEY=change-me-please

# Optional: use an existing n8n instead of the bundled one
# N8N_CONTAINER=my-n8n
# N8N_URL=http://localhost:5678
# PG_HOST_FOR_N8N=host.docker.internal
# PG_PORT_FOR_N8N=5433
# N8N_WEBHOOK_BASE=http://host.docker.internal:5678/webhook

# Optional: use an existing n8n instead of the bundled one
# N8N_CONTAINER=my-n8n
# N8N_URL=http://localhost:5678
# PG_HOST_FOR_N8N=host.docker.internal
# PG_PORT_FOR_N8N=5433
# N8N_WEBHOOK_BASE=http://host.docker.internal:5678/webhook

# Firebase Auth (web app config is public; the admin credential lives in ./secrets, never in Git)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
DEMO_MODE=true          # exposes /demo (ERP maintenance toggle). false for the client build.
CLERK_APPROVAL_LIMIT=10000
